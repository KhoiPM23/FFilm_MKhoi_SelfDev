# ==============================================================================
# FFilm Environment Variables Template
# Copy this file to .env (do NOT commit secrets or .env to version control)
# ==============================================================================

# --- Google OAuth2 (Sign in with Google) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# --- AI & External APIs ---
GEMINI_API_KEY=your-gemini-api-key
TMDB_API_KEY=148c2d2c497b43450ec77686438576b8
TENOR_API_KEY=your-tenor-api-key
TENOR_CLIENT_KEY=FFilm_Connect

# --- Server & Base URL ---
PORT=8081
APP_BASE_URL=http://localhost:8081

# ==============================================================================
# LOCAL DEVELOPMENT (SQL Server Express + Gmail SMTP)
# ==============================================================================

# Database (local SQL Server)
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=FFilm3;encrypt=true;trustServerCertificate=true;loginTimeout=30;sendStringParametersAsUnicode=true;
DB_USERNAME=sa
DB_PASSWORD=123

# Email (Gmail SMTP — works locally, blocked on Render free tier)
EMAIL_PROVIDER=smtp
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# ==============================================================================
# PRODUCTION (Render.com + Azure SQL Database)
# ==============================================================================

# Database (Azure SQL — SQL Server compatible, 32GB free, permanent)
# DB_URL=jdbc:sqlserver://<server>.database.windows.net:1433;database=<db>;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30;
# DB_USERNAME=<azure-admin>
# DB_PASSWORD=<azure-password>

# Email (Resend HTTP API — bypasses Render SMTP port block)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_your_resend_api_key
# RESEND_FROM_EMAIL=noreply@yourdomain.com  # Must be verified in Resend dashboard

# App base URL for production
# APP_BASE_URL=https://ffilm.onrender.com

# ==============================================================================
# OPTIONAL / PAYMENT
# ==============================================================================

# VNPay Payment Gateway (sandbox)
VNPAY_TMN_CODE=8NCYOTU5
VNPAY_HASH_SECRET=FDTOUCRNVVWGNTWMBZSZNUUPENYYTHOO
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

